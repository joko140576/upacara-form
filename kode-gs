// ── KONFIGURASI — GANTI ID INI ───────────────────────────
const CONFIG = {
  SPREADSHEET_ID: 'GANTI_DENGAN_ID_SPREADSHEET_ANDA',
  // Contoh: '1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms'

  DRIVE_FOLDER_ID: 'GANTI_DENGAN_ID_FOLDER_GOOGLE_DRIVE',
  // Contoh: '1a2B3cD4eF5gH6iJ7kL8mN9oP0'

  SHEET_NAME: 'Data Kehadiran',

  // Header kolom spreadsheet
  HEADERS: ['No', 'Timestamp', 'Nama Lengkap', 'NPP', 'Lokasi Kerja', 'Link Evidence', 'Nama File', 'Status']
};

// ─────────────────────────────────────────────────────────
//  doPost — Menerima data dari form HTML (method: POST)
// ─────────────────────────────────────────────────────────
function doPost(e) {
  // Header CORS — wajib untuk menghindari CORS error
  const headers = {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'POST, GET, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type',
    'Content-Type': 'application/json'
  };

  try {
    // Parse body JSON
    const body = JSON.parse(e.postData.contents);
    const { nama, npp, lokasi, timestamp, fileName, fileType, fileData } = body;

    // ── 1. Upload file ke Google Drive ──────────────────
    let fileLink = '—';
    let finalFileName = fileName || 'evidence';

    if (fileData) {
      const folder = DriveApp.getFolderById(CONFIG.DRIVE_FOLDER_ID);
      const decoded = Utilities.base64Decode(fileData);
      const blob = Utilities.newBlob(decoded, fileType, `[${npp}] ${nama} - ${finalFileName}`);
      const uploadedFile = folder.createFile(blob);

      // Set file dapat diakses oleh siapa saja yang memiliki link
      uploadedFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      fileLink = uploadedFile.getUrl();
    }

    // ── 2. Simpan ke Google Sheets ───────────────────────
    const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
    let sheet = ss.getSheetByName(CONFIG.SHEET_NAME);

    // Buat sheet baru jika belum ada
    if (!sheet) {
      sheet = ss.insertSheet(CONFIG.SHEET_NAME);
      setupSheet(sheet);
    }

    const lastRow = sheet.getLastRow();
    const no = lastRow <= 1 ? 1 : lastRow; // nomor urut

    sheet.appendRow([
      no,
      timestamp || new Date().toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }),
      nama,
      npp,
      lokasi,
      fileLink,
      finalFileName,
      '✓ Hadir'
    ]);

    // Format baris baru
    formatLastRow(sheet);

    return ContentService
      .createTextOutput(JSON.stringify({
        status: 'success',
        message: 'Data berhasil disimpan',
        row: lastRow + 1
      }))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (err) {
    return ContentService
      .createTextOutput(JSON.stringify({
        status: 'error',
        message: err.message
      }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

// ─────────────────────────────────────────────────────────
//  doGet — Handle preflight OPTIONS & GET (anti-CORS)
// ─────────────────────────────────────────────────────────
function doGet(e) {
  return ContentService
    .createTextOutput(JSON.stringify({
      status: 'ok',
      app: 'Pancasila Day 2026 Form API',
      version: '1.0'
    }))
    .setMimeType(ContentService.MimeType.JSON);
}

// ─────────────────────────────────────────────────────────
//  setupSheet — Buat header & format sheet baru
// ─────────────────────────────────────────────────────────
function setupSheet(sheet) {
  // Header row
  const headerRange = sheet.getRange(1, 1, 1, CONFIG.HEADERS.length);
  headerRange.setValues([CONFIG.HEADERS]);

  // Styling header
  headerRange
    .setBackground('#B8001B')
    .setFontColor('#FFFFFF')
    .setFontWeight('bold')
    .setFontSize(11)
    .setHorizontalAlignment('center')
    .setBorder(true, true, true, true, true, true, '#880013', SpreadsheetApp.BorderStyle.SOLID);

  // Freeze header row
  sheet.setFrozenRows(1);

  // Set column widths
  sheet.setColumnWidth(1, 50);   // No
  sheet.setColumnWidth(2, 180);  // Timestamp
  sheet.setColumnWidth(3, 220);  // Nama
  sheet.setColumnWidth(4, 100);  // NPP
  sheet.setColumnWidth(5, 200);  // Lokasi
  sheet.setColumnWidth(6, 300);  // Link
  sheet.setColumnWidth(7, 200);  // File name
  sheet.setColumnWidth(8, 100);  // Status

  // Add title above headers
  sheet.insertRowBefore(1);
  const titleRange = sheet.getRange(1, 1, 1, CONFIG.HEADERS.length);
  titleRange.merge()
    .setValue('📋 DATA KEHADIRAN UPACARA HARI LAHIR PANCASILA 2026')
    .setBackground('#CC0000')
    .setFontColor('#FFD700')
    .setFontWeight('bold')
    .setFontSize(13)
    .setHorizontalAlignment('center')
    .setVerticalAlignment('middle');
  sheet.setRowHeight(1, 40);
  sheet.setFrozenRows(2);
}

// ─────────────────────────────────────────────────────────
//  formatLastRow — Styling baris data baru
// ─────────────────────────────────────────────────────────
function formatLastRow(sheet) {
  const lastRow = sheet.getLastRow();
  const range = sheet.getRange(lastRow, 1, 1, CONFIG.HEADERS.length);

  // Alternating row color
  const bg = lastRow % 2 === 0 ? '#FFF8E7' : '#FFFFFF';
  range.setBackground(bg);

  // Border
  range.setBorder(false, false, true, false, false, false, '#DDDDDD', SpreadsheetApp.BorderStyle.SOLID);

  // Center No & Status columns
  sheet.getRange(lastRow, 1).setHorizontalAlignment('center');
  sheet.getRange(lastRow, 8).setHorizontalAlignment('center');

  // Make link column clickable formula if it's a URL
  const linkCell = sheet.getRange(lastRow, 6);
  const linkValue = linkCell.getValue();
  if (linkValue && linkValue.startsWith('http')) {
    linkCell.setFormula(`=HYPERLINK("${linkValue}","🔗 Lihat File")`);
    linkCell.setFontColor('#1155CC');
  }
}

// ─────────────────────────────────────────────────────────
//  createSummarySheet — (Opsional) Buat ringkasan per lokasi
// ─────────────────────────────────────────────────────────
function createSummarySheet() {
  const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  let summary = ss.getSheetByName('Ringkasan');
  if (!summary) summary = ss.insertSheet('Ringkasan');
  summary.clearContents();

  const dataSheet = ss.getSheetByName(CONFIG.SHEET_NAME);
  if (!dataSheet) return;

  const data = dataSheet.getDataRange().getValues();
  const locationCount = {};

  // Skip header rows (row 1=title, row 2=header)
  for (let i = 2; i < data.length; i++) {
    const loc = data[i][4]; // kolom Lokasi Kerja
    if (loc) locationCount[loc] = (locationCount[loc] || 0) + 1;
  }

  summary.getRange(1, 1, 1, 3).setValues([['Lokasi Kerja', 'Jumlah Hadir', 'Persentase']]);
  summary.getRange(1, 1, 1, 3)
    .setBackground('#B8001B')
    .setFontColor('#FFD700')
    .setFontWeight('bold');

  let row = 2;
  const total = data.length - 2;
  Object.entries(locationCount).sort((a,b) => b[1]-a[1]).forEach(([loc, count]) => {
    summary.getRange(row, 1, 1, 3).setValues([[
      loc, count, total > 0 ? `${((count/total)*100).toFixed(1)}%` : '0%'
    ]]);
    row++;
  });

  summary.getRange(row, 1, 1, 3).setValues([['TOTAL', total, '100%']]);
  summary.getRange(row, 1, 1, 3)
    .setFontWeight('bold')
    .setBackground('#FFD700');
}

